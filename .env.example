# Cademmy - Environment Variables Template
# Copia este archivo como .env y coloca tus llaves reales.
# ¡NUNCA SUBAS EL ARCHIVO .env A CONTROL DE VERSIONES (GIT)!

# --- FIREBASE (PUBLICAS) ---
VITE_FIREBASE_API_KEY=tu_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=tu_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=tu_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_firebase_app_id

# --- SERVICIOS TERCEROS (LLAVES PÚBLICAS) ---
VITE_STRIPE_PUBLIC_KEY=tu_llave_publica_de_stripe_aqui
VITE_PAYPAL_CLIENT_ID=tu_client_id_de_paypal_aqui

# --- SEGURIDAD ---
# LLAVES SECRETAS (NUNCA USAR PREFIJO VITE_):
# GEMINI_API_KEY (Debe inyectarse como Secreto en Firebase/Netlify Backend)
# STRIPE_SECRET_KEY (Debe inyectarse como Secreto en Firebase Functions)
